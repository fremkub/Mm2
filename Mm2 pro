function clearRight() for _,v in pairs(right:GetChildren()) do if not v:IsA("UIListLayout") then v:Destroy() end end end
function createTab(name, callback)
    local b = Instance.new("TextButton", left); b.Size = UDim2.new(1,0,0,40); b.Text = name; b.BackgroundColor3 = Color3.fromRGB(40,40,40); b.TextColor3 = Color3.new(1,1,1); b.Font = "GothamBold"
    b.MouseButton1Click:Connect(function() clearRight(); callback() end)
end
function createToggle(name, func, order)
    local b = Instance.new("TextButton", right); b.Size = UDim2.new(1,-10,0,40); b.Text = name.." : OFF"; b.BackgroundColor3 = Color3.fromRGB(60,60,60); b.TextColor3 = Color3.new(1,1,1); b.LayoutOrder = order or 0
    local s = false; b.MouseButton1Click:Connect(function() s = not s; b.Text = name..(s and " : ON" or " : OFF"); func(s) end)
end

