                local l = plr.Character.Humanoid:LoadAnimation(a); l:Play(); l:AdjustSpeed(10); task.wait(0.2); l:Stop() 
            end
            -- ท่าเลื้อย
            if _G.SnakeFlow then 
                local a = Instance.new("Animation"); a.AnimationId = "rbxassetid://5918726674"
                local l = plr.Character.Humanoid:LoadAnimation(a); l:Play(); l:AdjustSpeed(1.5); task.wait(2.5); l:Stop() 
            end
            -- ท่า Victory
            if _G.VictoryPose then 
                if not activeAnims.Victory then
                    local a = Instance.new("Animation"); a.AnimationId = "rbxassetid://507771019"
                    activeAnims.Victory = plr.Character.Humanoid:LoadAnimation(a); activeAnims.Victory:Play()
                end
            else if activeAnims.Victory then activeAnims.Victory:Stop(); activeAnims.Victory = nil end end
            
            -- [NEW] ท่าส่ายสะโพกสุดกวน
            if _G.HipsShake then
                if not activeAnims.Hips then
                    local a = Instance.new("Animation"); a.AnimationId = "rbxassetid://429703734" -- ท่ากวนๆ
                    activeAnims.Hips = plr.Character.Humanoid:LoadAnimation(a); activeAnims.Hips:Play(); activeAnims.Hips:AdjustSpeed(2)
                end
            else if activeAnims.Hips then activeAnims.Hips:Stop(); activeAnims.Hips = nil end end
        end
    end
end)

-- [[ SLOW AUTO FARM ]]
task.spawn(function()
    while task.wait(1.5) do
        if _G.AutoFarm and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            for _, v in pairs(workspace:GetDescendants()) do
                if (v.Name:lower():find("coin") or v.Name == "Touch") and v:IsA("BasePart") and v.Transparency < 1 and _G.AutoFarm then
                    local info = TweenInfo.new(2.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
